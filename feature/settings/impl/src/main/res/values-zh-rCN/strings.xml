    <string name="settings_gps_section_controls_how_the_fake_gps_signal">"控制模拟 GPS 信号的行为方式。这些选项会添加真实 GPS 芯片产生的元数据与变化 — 部分应用和游戏会检查这些信号来识别模拟位置。"</string>
    <string name="settings_gps_section_hold_bearing_when_stationary">"静止时保持方位"</string>
    <string name="settings_gps_section_hold_bearing_when_stationary_desc">"停止移动时保留最后的已知方向，而不是跳回 0°（正北）。真实 GPS 芯片也是如此 — 方向突然归零是常见的模拟定位破绽。"</string>
    <string name="settings_gps_section_vary_altitude">"海拔变化"</string>
    <string name="settings_gps_section_vary_altitude_desc">"模拟一个合理的海拔并带有小幅随机漂移，而不是始终上报 0 米。海拔恒为 0 是位置由程序模拟的明显特征。"</string>
    <string name="settings_gps_section_vary_altitude_ft">"海拔变化（英尺）"</string>
    <string name="settings_gps_section_vary_altitude_m">"海拔变化（米）"</string>
    <string name="settings_gps_section_use_real_world_elevation">"使用真实海拔"</string>
    <string name="settings_gps_section_use_real_world_elevation_desc">"模拟定位期间每分钟查询一次模拟位置处的实际地面海拔，而不是使用固定的约 35 米。需要联网；手动海拔覆盖生效时会自动暂停（悬浮窗），查询失败则回退到固定值。"</string>
    <string name="settings_gps_section_reset_elevation_override">"重置海拔覆盖"</string>
    <string name="settings_gps_section_clears_a_manually_set_altitude_floating">"清除手动设置的海拔（悬浮窗），并恢复自动海拔查询。"</string>
    <string name="settings_gps_section_gps_warm_up_simulation">"GPS 预热模拟"</string>
    <string name="settings_gps_section_gps_warm_up_simulation_desc">"每次开始模拟时先给出略有偏差的读数，并在约 30 秒内逐渐变准，就像真实 GPS 需要时间锁定卫星。默认关闭，因为它会在开始阶段暂时降低位置精度。"</string>
    <string name="settings_gps_section_realistic_satellite_count">"真实卫星数量"</string>
    <string name="settings_gps_section_realistic_satellite_count_desc">"每次位置更新都附带卫星元数据（可见 7–14 颗、参与定位 6–12 颗），而不是 0 颗。部分应用会把卫星数为 0 当作模拟定位的特征。"</string>
    <string name="settings_gps_section_simulate_signal_dropouts">"模拟信号中断"</string>
    <string name="settings_gps_section_simulate_signal_dropouts_desc">"每隔约 10 秒短暂中断一次模拟位置信号，类似真实 GPS 偶尔丢失信号。默认关闭 — 中断会导致大多数应用出现可见卡顿。路线回放期间会自动跳过。"</string>
