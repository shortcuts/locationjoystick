    <string name="settings_gps_section_vary_altitude_m">"海拔變化（公尺）" </string>
    <string name="settings_gps_section_use_real_world_elevation">"使用真實海拔"</string>
    <string name="settings_gps_section_use_real_world_elevation_desc">"模擬定位期間每分鐘查詢一次模擬位置處的實際地面海拔，而不是使用固定的約 35 公尺。需要連網；手動覆蓋海拔生效時會自動暫停（浮動小工具），查詢失敗則退回固定值。"</string>
    <string name="settings_gps_section_reset_elevation_override">"重設海拔覆蓋"</string>
    <string name="settings_gps_section_clears_a_manually_set_altitude_floating">"清除手動設定的海拔（浮動小工具），並恢復自動海拔查詢。"</string>
    <string name="settings_gps_section_gps_warm_up_simulation">"GPS 暖機模擬"</string>
