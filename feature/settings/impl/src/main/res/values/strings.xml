    <string name="settings_gps_section_controls_how_the_fake_gps_signal">"These options add the metadata and variation that real GPS chips produce. Some apps and games check these signals to detect fake locations."</string>
    <string name="settings_gps_section_hold_bearing_when_stationary">"Hold bearing when stationary"</string>
    <string name="settings_gps_section_hold_bearing_when_stationary_desc">"Keeps the last known direction when you stop moving instead of snapping to 0° (north). Real GPS chips do the same, and a sudden reset to north is a common sign of a fake location."</string>
    <string name="settings_gps_section_vary_altitude">"Vary altitude"</string>
    <string name="settings_gps_section_vary_altitude_desc">"Reports an altitude with small random drift instead of always 0 m. A flat zero altitude shows that the location is fake."</string>
    <string name="settings_gps_section_vary_altitude_ft">"Vary altitude (ft)"</string>
    <string name="settings_gps_section_vary_altitude_m">"Vary altitude (m)"</string>
    <string name="settings_gps_section_use_real_world_elevation">"Use real-world elevation"</string>
    <string name="settings_gps_section_use_real_world_elevation_desc">"Looks up the real ground elevation at your fake location every minute, instead of a fixed 35 m. Needs internet. Pauses while an altitude override is active (floating widget). If the lookup fails, the app uses 35 m."</string>
    <string name="settings_gps_section_reset_elevation_override">"Reset elevation override"</string>
    <string name="settings_gps_section_clears_a_manually_set_altitude_floating">"Clears an altitude you set by hand (floating widget) so automatic elevation lookup resumes."</string>
    <string name="settings_gps_section_gps_warm_up_simulation">"GPS warm-up simulation"</string>
    <string name="settings_gps_section_gps_warm_up_simulation_desc">"Starts each session with slightly inaccurate readings that improve over about 30 seconds, like a real GPS that takes time to lock on. Off by default because it lowers precision at the start of a session."</string>
    <string name="settings_gps_section_realistic_satellite_count">"Realistic satellite count"</string>
    <string name="settings_gps_section_realistic_satellite_count_desc">"Reports 7 to 14 visible satellites and 6 to 12 in use, instead of zero. Some apps treat zero satellites as a sign of spoofing."</string>
    <string name="settings_gps_section_simulate_signal_dropouts">"Simulate signal dropouts"</string>
    <string name="settings_gps_section_simulate_signal_dropouts_desc">"Freezes the fake location signal for a moment about every 10 seconds, like a real GPS losing signal. Off by default because most apps show the freeze. Does not run during route replay."</string>
